# ==========================================
# DEPENDENCIAS Y PAQUETES (Muy pesados)
# ==========================================
**/node_modules/
**/vendor/

# ==========================================
# ARCHIVOS DE ENTORNO Y CREDENCIALES (Seguridad)
# ==========================================
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# ==========================================
# ARCHIVOS DE COMPILACIÓN / BUILDS
# ==========================================
**/dist/
**/build/
**/out/
**/*.o
**/*.exe

# ==========================================
# ARCHIVOS DEL SISTEMA OPERATIVO E IDEs
# ==========================================
.DS_Store
Thumbs.db
**/.vscode/
**/.idea/

# ==========================================
# LOGS Y ARCHIVOS TEMPORALES
# ==========================================
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*